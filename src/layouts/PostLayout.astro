---
import type { ImageMetadata } from 'astro:assets';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  categories?: string[];
  coverImage?: ImageMetadata;
  description?: string;
}

const { title, date, categories = [], coverImage, description } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const ogImage = coverImage
  ? (await getImage({ src: coverImage, width: 1200, height: 630 })).src
  : undefined;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <!--
    data-pagefind-body scopes Pagefind's index to the post itself — the title,
    date, categories and rendered markdown — so the Header/Footer chrome that
    repeats on every page never lands in a search result.
  -->
  <div data-pagefind-body>
    <!-- Hero / cover image -->
    {coverImage ? (
      <div class="relative w-full max-h-[480px] overflow-hidden">
        <Image
          src={coverImage}
          alt={title}
          width={1600}
          height={900}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-bg to-transparent" />
      </div>
    ) : (
      <div class="w-full h-32 bg-gradient-to-r from-brand-tint via-linkblue/30 to-brand-tint border-b border-accent/20" />
    )}

    <!-- Post header -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-4 border-b border-accent/10">
      {categories.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {categories.map(cat => (
            <span class="text-xs font-semibold uppercase tracking-widest text-accent">
              {cat}
            </span>
          ))}
        </div>
      )}
      <h1 class="text-3xl sm:text-4xl font-bold text-fg leading-tight mb-3">{title}</h1>
      <p class="text-subtle text-sm">{formattedDate}</p>
    </div>

    <!-- Post content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <article class="prose prose-site prose-lg max-w-none">
        <slot />
      </article>
    </div>
  </div>

  <!-- Plausible send blog post view event -->
  <script>
    window.plausible?.('Blog Post View', { props: { title:document.title } });
  </script>
</BaseLayout>
