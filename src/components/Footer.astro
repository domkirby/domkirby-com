---
const year = new Date().getFullYear();
---

<div class="mt-16 h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>
<footer class="bg-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-muted text-sm">
        &copy; {year} Dom Kirby. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="https://bsky.app/profile/domkirby.com" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent text-sm transition-colors">Bluesky</a>
        <a href="https://linkedin.com/in/dominickirby" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent text-sm transition-colors">LinkedIn</a>
        <a href="https://youtube.com/@domkirby" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent text-sm transition-colors">YouTube</a>
        <a href="/privacy" class="text-muted hover:text-accent text-sm transition-colors">Privacy</a>
      </div>
    </div>
    <div class="mt-6 pt-6 border-t border-accent/20">
      <p class="text-subtle text-xs">
        The views and opinions expressed on this site are my own and do not represent my employers or affiliates.
      </p>
    </div>
  </div>
</footer>
